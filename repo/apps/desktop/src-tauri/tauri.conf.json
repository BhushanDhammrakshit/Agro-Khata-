{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAG Mall",
  "version": "0.1.0",
  "identifier": "com.kagmall.desktop",
  "app": {
    "windows": [
      {
        "title": "KAG Mall",
        "url": "https://vajabaki.com/",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
