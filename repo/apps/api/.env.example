PORT=3001
WEB_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kag_mall
DB_SSL=false
# app_superadmin BYPASSRLS role (see docs/schema.sql). Defaults to the main
# DB credentials above if unset — fine for local dev, NOT for production.
SUPERADMIN_DB_USERNAME=
SUPERADMIN_DB_PASSWORD=

JWT_SECRET=change-me-in-azure-key-vault
JWT_EXPIRES_IN=12h

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

SUPERADMIN_JWT_SECRET=change-me-in-azure-key-vault
SUPERADMIN_JWT_EXPIRES_IN=8h
# Seeds the first platform admin account on startup if none exists yet.
SUPERADMIN_BOOTSTRAP_EMAIL=
SUPERADMIN_BOOTSTRAP_PASSWORD=
SUPERADMIN_BOOTSTRAP_NAME=Platform Admin
